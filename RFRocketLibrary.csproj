<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>RFRocketLibrary</AssemblyName>
    <RootNamespace>RFRocketLibrary</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The test suite under tests/ has its own project; keep the default glob out of it. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!--
    Modernized build: game/framework assemblies now come from the always up-to-date
    RocketModFix redistributable NuGet packages instead of local HintPath copies.
  -->
  <ItemGroup>
    <PackageReference Include="RocketModFix.Unturned.Redist.Server" Version="3.26.3.12" />
    <PackageReference Include="RocketModFix.LDM.Redist" Version="4.9.3.18" />
    <PackageReference Include="RocketModFix.UnityEngine.Redist" Version="2022.3.62.3" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>

