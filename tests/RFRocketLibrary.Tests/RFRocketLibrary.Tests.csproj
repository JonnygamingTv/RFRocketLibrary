<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Game/Rocket assemblies resolve against the redistributable packages, not a server install. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Needed at JIT time: RFRocketLibrary logging catch paths and typeof() tokens resolve
         Rocket.Core/Assembly-CSharp even when those code paths never execute. -->
    <PackageReference Include="RocketModFix.LDM.Redist" Version="4.9.3.18" />
    <PackageReference Include="RocketModFix.Unturned.Redist.Server" Version="3.26.3.12" />
    <PackageReference Include="RocketModFix.UnityEngine.Redist" Version="2022.3.62.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RFRocketLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server-distributed netstandard 2.1 facade: Rocket's logging chain bottoms out in
         SDG.Unturned.CommandWindow, which requires the 2.1 facade at JIT time even on paths
         that never execute. A plain .NET Framework host does not ship one, so the copy that
         Unturned servers themselves distribute is bundled with the tests (see README note). -->
    <None Include="netstandard.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
